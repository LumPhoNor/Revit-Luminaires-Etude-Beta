<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Configurations nommées "<Debug|Release> R<annee>" (ex: "Release R25").
    R24 -> Revit 2024 (.NET Framework 4.8)
    R25 -> Revit 2025 (.NET 8)
    R26 -> Revit 2026 (.NET 8)
  -->
  <PropertyGroup>
    <Configurations>Debug R24;Release R24;Debug R25;Release R25;Debug R26;Release R26</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <RevitVersion Condition="$(Configuration.Contains('R24'))">2024</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R25'))">2025</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R26'))">2026</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2024'">
    <TargetFramework>net48</TargetFramework>
    <RevitApiVersion>2024.3.60</RevitApiVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2025'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <RevitApiVersion>2025.4.60</RevitApiVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2026'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <RevitApiVersion>2026.4.10</RevitApiVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>RevitLightingPlugin</AssemblyName>
    <RootNamespace>RevitLightingPlugin</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>bin\x64\</BaseOutputPath>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <NoWarn>NU1701</NoWarn>
    <!-- Revit charge le DLL directement (pas via deps.json) : les dependances NuGet
         doivent etre copiees a cote du plugin, meme en net8.0-windows (R25/R26). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle" Version="1.8.9" />
    <PackageReference Include="iTextSharp" Version="5.5.13.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="RevitLightingPlugin.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DeployToRevitAddins" AfterTargets="Build">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)**\*.pdb" />
    </ItemGroup>
    <PropertyGroup>
      <AppDataFolder>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)</AppDataFolder>
    </PropertyGroup>
    <MakeDir Directories="$(AppDataFolder)" Condition="!Exists('$(AppDataFolder)')" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(AppDataFolder)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
